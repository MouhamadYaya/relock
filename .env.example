API_URL=http://localhost:3000
# Dev: enables mock REST + pre-fills login (demo@example.com / password) on Auth screen
USE_MOCK_API=true

# Optional: WebSocket transport base URL (used by websocket.adapter.ts)
WS_URL=
# Runtime environment label — defaults to "development" in __DEV__, "production" otherwise
ENV=

# Optional: Sentry (https://docs.sentry.io/platforms/react-native/)
# DSN du projet Sentry. Vide = Sentry entièrement inerte (aucun réseau).
# Ce n'est PAS un secret : il part dans le binaire. Le secret, c'est le jeton
# de ios/sentry.properties et android/sentry.properties.
SENTRY_DSN=
# Set to 1 to send events from __DEV__ builds (default: off)
SENTRY_ENABLE_IN_DEV=0
# 0–1, performance sampling in production (0 = traces off). 0.2 est un bon
# point de départ : assez pour voir les tendances, sans exploser le quota.
SENTRY_TRACES_SAMPLE_RATE=0
# 0–1, profilage Hermes. N'échantillonne QUE parmi les traces déjà retenues :
# le taux effectif est TRACES × PROFILES.
SENTRY_PROFILES_SAMPLE_RATE=0
# 0–1, part des sessions enregistrées de bout en bout (Session Replay).
# Coûteux : garder très bas, voire 0.
SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
# 0–1, part des sessions AVEC erreur dont on garde les ~30 s précédentes.
# C'est le réglage utile : 1.0 ne coûte que sur les sessions qui plantent.
SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0

# OTA / CodePush-style keys — see docs/OPERATIONS.md#over-the-air-updates (optional)
CODEPUSH_KEY_IOS=
CODEPUSH_KEY_ANDROID=
# Supabase (créer un projet sur supabase.com, exécuter supabase/schema.sql)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Sign in with Google (Google Cloud Console → Credentials → OAuth client IDs).
# Activer aussi le provider "Google" dans Supabase Auth avec le même Web client ID/secret.
GOOGLE_WEB_CLIENT_ID=
# Client iOS ; sa forme inversée (com.googleusercontent.apps.XXX) va aussi dans
# CFBundleURLSchemes (ios/Relock/Info.plist).
GOOGLE_IOS_CLIENT_ID=

# RevenueCat paywall + abonnement.
# Active l'intégration RC quand défini à 1 / true / yes.
REVENUECAT_ENABLED=0
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=
REVENUECAT_ENTITLEMENT_ID=relock_pro
# Offering RevenueCat contenant le produit remisé (écran de rattrapage).
# Laisser vide = « discount ». Sans cet offering, aucune remise n'est affichée.
REVENUECAT_DISCOUNT_OFFERING_ID=discount

# ImageKit — CDN média + transformations d'images (https://imagekit.io/dashboard)
# Aucune de ces deux valeurs n'est secrète : elles partent dans le binaire.
# L'endpoint est visible dans chaque URL d'image ; la public key ne permet
# qu'un upload accompagné d'une signature serveur.
# Vide = ImageKit inerte (l'app retombe sur ses avatars à initiales).
# Laisser VIDE tant que le compte n'est pas branché : un endpoint
# d'exemple passerait `isImageKitConfigured()` et ferait pointer les
# chemins stockés vers un compte inexistant — images cassées au lieu du
# repli documenté sur les initiales.
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
# ⚠️ La PRIVATE KEY ne se met JAMAIS ici. Elle se configure côté Supabase :
#    supabase secrets set IMAGEKIT_PRIVATE_KEY=private_xxx
